# ── RabbitMQ ──────────────────────────────────────────────────
RABBITMQ_URL=amqp://smartpark:smartpark_secret@localhost:5672

# ── Camera / Lot identity ────────────────────────────────────
CAM_ROLE=entry          # "entry" or "exit"
LOT_ID=default-lot      # parking lot UUID from backend
CAM_ID=cam-01           # unique camera identifier

# ── ESP32-CAM stream ─────────────────────────────────────────
ESP32_URL=http://172.20.10.4:81/stream

# ── ESP32 gate control (HTTP) ────────────────────────────────
# Defaults to http://<ESP32_IP> (port 80) derived from ESP32_URL
# Override if the gate endpoint is on a different address/port
ESP32_GATE_URL=http://172.20.10.4
